                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"materials\": [\n    {\n      \"id\": \"material-uuid-1\",\n      \"name\": \"Katun Premium\",\n      \"pricePerUnit\": 25000,\n      \"unit\": \"meter\",\n      \"isActive\": true,\n      \"createdAt\": \"2024-01-01T00:00:00Z\",\n      \"updatedAt\": \"2024-01-01T00:00:00Z\",\n      \"createdBy\": \"user123\"\n    },\n    {\n      \"id\": \"material-uuid-2\",\n      \"name\": \"Sutra Halus\",\n      \"pricePerUnit\": 50000,\n      \"unit\": \"meter\",\n      \"isActive\": true,\n      \"createdAt\": \"2024-01-01T00:00:00Z\",\n      \"updatedAt\": \"2024-01-01T00:00:00Z\",\n      \"createdBy\": \"user123\"\n    }\n  ],\n  \"pagination\": {\n    \"page\": 1,\n    \"limit\": 2,\n    \"total\": 15,\n    \"totalPages\": 8\n  }\n}"
            }
