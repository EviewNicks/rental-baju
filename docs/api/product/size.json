  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Set default headers",
          "pm.request.headers.add({",
          "  key: 'User-Agent',",
          "  value: 'PostmanRuntime/7.32.3'",
          "});"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Enhanced test script for Material Management System (RPK-45)",
          "pm.test('Status code is success (200, 201)', function () {",
          "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
          "});",
          "",
          "pm.test('Response time is under 2s', function () {",
          "  pm.expect(pm.response.responseTime).to.be.below(2000);",
          "});",
          "",
          "pm.test('Response has valid structure', function () {",
          "  const response = pm.response.json();",
          "  if (pm.response.code !== 200 && pm.response.code !== 201) return;",
          "  ",
          "  // For delete responses",
          "  if (response.message && response.success !== undefined) {",
          "    pm.expect(response).to.have.property('success');",
          "  } else {",
          "    pm.expect(response).to.have.property('id');",
          "  }",
          "});",
          "",
          "// Test Material Management response structure",
          "if (pm.request.url.path.includes('materials')) {",
          "  pm.test('Material response has required fields', function () {",
          "    const response = pm.response.json();",
          "    if (pm.response.code !== 200 && pm.response.code !== 201) return;",
          "    ",
          "    if (response.materials) {",
          "      // Materials list response",
          "      pm.expect(response).to.have.property('pagination');",
          "      const material = response.materials[0];",
          "      if (material) {",
          "        pm.expect(material).to.have.property('name');",
          "        pm.expect(material).to.have.property('pricePerUnit');",
          "        pm.expect(material).to.have.property('unit');",
          "        pm.expect(material).to.have.property('isActive');",
          "        pm.expect(material.pricePerUnit).to.be.a('number');",
          "        pm.expect(material.pricePerUnit).to.be.above(0);",
          "      }",
          "    } else if (response.id && response.name) {",
          "      // Single material response",
          "      pm.expect(response).to.have.property('name');",
          "      pm.expect(response).to.have.property('pricePerUnit');",
          "      pm.expect(response).to.have.property('unit');",
          "      pm.expect(response).to.have.property('isActive');",
          "      pm.expect(response.pricePerUnit).to.be.a('number');",
          "      pm.expect(response.pricePerUnit).to.be.above(0);",
          "    }",
          "  });",
          "}",
          "",
          "// Test enhanced product response structure with material fields",
          "if (pm.request.url.path.includes('products')) {",
          "  pm.test('Product has enhanced fields (size, color, material)', function () {",
          "    const response = pm.response.json();",
          "    if (pm.response.code !== 200 && pm.response.code !== 201) return;",
          "    ",
          "    if (response.products) {",
          "      // List response",
          "      const product = response.products[0];",
          "      if (product) {",
          "        pm.expect(product).to.have.property('size');",
          "        pm.expect(product).to.have.property('colorId');",
          "        pm.expect(product).to.have.property('color');",
          "        // Material fields (optional)",
          "        if (product.materialId) {",
          "          pm.expect(product).to.have.property('materialCost');",
          "          pm.expect(product).to.have.property('materialQuantity');",
          "          pm.expect(product).to.have.property('material');",
          "          pm.expect(product.materialCost).to.be.a('number');",
          "          pm.expect(product.materialQuantity).to.be.a('number');",
          "        }",
          "      }",
          "    } else if (response.id) {",
          "      // Single product response",
          "      pm.expect(response).to.have.property('size');",
          "      pm.expect(response).to.have.property('colorId');",
          "      pm.expect(response).to.have.property('color');",
          "      // Material fields (optional)",
          "      if (response.materialId) {",
          "        pm.expect(response).to.have.property('materialCost');",
          "        pm.expect(response).to.have.property('materialQuantity');",
          "        pm.expect(response).to.have.property('material');",
          "        pm.expect(response.materialCost).to.be.a('number');",
          "        pm.expect(response.materialQuantity).to.be.a('number');",
          "      }",
          "    }",
          "  });",
          "}",
          "",
          "// Test Product History API response structure (RPK-46)",
          "if (pm.request.url.path.includes('products') && pm.request.url.path.includes('history')) {",
          "  pm.test('Product History has correct structure', function () {",
          "    const response = pm.response.json();",
          "    if (pm.response.code !== 200) return;",
          "    ",
          "    // Success response structure validation",
          "    pm.expect(response).to.have.property('success');",
          "    pm.expect(response.success).to.eql(true);",
          "    pm.expect(response).to.have.property('data');",
          "    pm.expect(response.data).to.be.an('array');",
          "    ",
          "    // Pagination structure validation",
          "    pm.expect(response).to.have.property('pagination');",
          "    pm.expect(response.pagination).to.have.property('page');",
          "    pm.expect(response.pagination).to.have.property('limit');",
          "    pm.expect(response.pagination).to.have.property('total');",
          "    pm.expect(response.pagination).to.have.property('totalPages');",
          "    ",
          "    // Data structure validation (if has data)",
          "    if (response.data.length > 0) {",
          "      const historyItem = response.data[0];",
          "      pm.expect(historyItem).to.have.property('id');",
          "      pm.expect(historyItem).to.have.property('transactionCode');",
          "      pm.expect(historyItem).to.have.property('customerName');",
          "      pm.expect(historyItem).to.have.property('baseRevenue');",
          "      pm.expect(historyItem).to.have.property('totalRevenue');",
          "      ",
          "      // Revenue calculation validation",
          "      const expectedTotal = historyItem.baseRevenue + historyItem.penaltyAmount;",
          "      pm.expect(historyItem.totalRevenue).to.eql(expectedTotal);",
          "    }",
          "  });",
          "}",
          "",
          "// Test color management response",
          "if (pm.request.url.path.includes('colors')) {",
          "  pm.test('Color response has required fields', function () {",
          "    const response = pm.response.json();",
          "    if (Array.isArray(response)) {",
          "      // List response",
          "      const color = response[0];",
          "      if (color) {",
          "        pm.expect(color).to.have.property('name');",
          "        pm.expect(color).to.have.property('hexCode');",
          "        pm.expect(color).to.have.property('isActive');",
          "      }",
          "    } else if (response.id) {",
          "      // Single color response",
          "      pm.expect(response).to.have.property('name');",
          "      pm.expect(response).to.have.property('hexCode');",
          "      pm.expect(response).to.have.property('isActive');",
          "    }",
          "  });",
          "}",
          "",
          "// Store IDs for subsequent requests",
          "if (pm.response.code === 201 || pm.response.code === 200) {",
          "  const response = pm.response.json();",
          "  if (response.id) {",
          "    if (pm.request.url.path.includes('products')) {",
          "      pm.collectionVariables.set('product_id', response.id);",
          "    } else if (pm.request.url.path.includes('categories')) {",
          "      pm.collectionVariables.set('category_id', response.id);",
          "    } else if (pm.request.url.path.includes('colors')) {",
          "      pm.collectionVariables.set('color_id', response.id);",
          "    } else if (pm.request.url.path.includes('materials')) {",
          "      pm.collectionVariables.set('material_id', response.id);",
          "    }",
          "  }",
          "}",
          "",
          "// Error scenario testing",
          "pm.test('Error responses have proper structure', function () {",
          "  if (pm.response.code >= 400) {",
          "    const response = pm.response.json();",
          "    pm.expect(response).to.have.property('error');",
          "    pm.expect(response.error).to.have.property('message');",
          "    pm.expect(response.error).to.have.property('code');",
          "  }",
          "});",
          "",
          "// Authentication testing",
          "pm.test('Unauthorized requests return 401', function () {",
          "  if (pm.response.code === 401) {",
          "    const response = pm.response.json();",
          "    pm.expect(response.error.code).to.eql('UNAUTHORIZED');",
          "  }",
          "});",
          "",
          "// Material-specific validation",
          "if (pm.request.url.path.includes('materials') && pm.request.method === 'POST') {",
          "  pm.test('Material creation validates required fields', function () {",
          "    if (pm.response.code === 400) {",
          "      const response = pm.response.json();",
          "      pm.expect(response.error.code).to.be.oneOf(['VALIDATION_ERROR', 'CONFLICT']);",
          "    }",
          "  });",
          "}",
          "",
          "// Performance monitoring",
          "pm.test('API performance meets SLA (<2s)', function () {",
          "  pm.expect(pm.response.responseTime).to.be.below(2000);",
          "});"
        ]
      }
    }
  ]
}
