generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id    String @id @default(cuid())
  name  String
  email String @unique
}

model Product {
  id               String          @id @default(uuid())
  code             String          @unique
  name             String
  description      String?
  modalAwal        Decimal         @db.Decimal(10, 2)
  imageUrl         String?
  categoryId       String
  status           ProductStatus   @default(AVAILABLE)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  createdBy        String
  size             String?
  currentPrice     Decimal         @db.Decimal(10, 2)
  materialCost     Decimal?        @db.Decimal(10, 2)
  materialId       String?
  materialQuantity Int?
  category         Category        @relation(fields: [categoryId], references: [id])
  material         Material?       @relation(fields: [materialId], references: [id])
  sizes            ProductSize[]
  transaksiItems   TransaksiItem[]
  productCosts     ProductCost[]

  @@index([isActive])
  @@index([categoryId])
  @@index([status])
  @@index([createdBy])
  @@index([size])
  @@index([id, modalAwal], map: "idx_product_penalty_calc")
  @@index([materialId])
  @@index([materialCost], map: "idx_product_material_cost")
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  color     String
  type      String    @default("clothing") // Category type: 'clothing', 'accessories_age_based', 'accessories_universal'
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  products  Product[]

  @@index([createdBy])
  @@index([type])
}

model Material {
  id           String    @id @default(uuid())
  name         String    @unique
  pricePerUnit Decimal   @db.Decimal(10, 2)
  unit         String    @default("meter")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String
  products     Product[]

  @@index([name])
  @@index([createdBy])
  @@map("materials")
}

model ProductSize {
  id               String      @id @default(uuid())
  productId        String
  ageCategory      AgeCategory
  size             SizeEnum
  quantity         Int         // Legacy field - will be migrated to originalQuantity
  originalQuantity Int         @default(0)  // Total stock owned
  rentedQuantity   Int         @default(0)  // Currently rented
  lostQuantity     Int         @default(0)  // Lost items (NEW: Task 1.1)
  availableQuantity Int        @default(0)  // Available for rent
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  createdBy        String
  product          Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, ageCategory, size])
  @@index([productId])
  @@index([ageCategory])
  @@index([isActive])
  @@index([createdBy])
  @@index([originalQuantity])
  @@index([rentedQuantity])
  @@index([availableQuantity])
  // TASK 2: Performance optimization indexes
  @@index([productId, isActive, availableQuantity], map: "idx_product_size_active_availability")
  @@index([productId, ageCategory, isActive], map: "idx_product_size_category_filter")
  // ✅ PERFORMANCE FIX: Active product lookup with price info
  @@index([isActive, productId], map: "idx_product_size_active_with_product")
  @@map("product_sizes")
}

model Penyewa {
  id        String      @id @default(uuid())
  nama      String
  telepon   String      @unique
  alamat    String
  email     String?
  nik       String?
  foto      String?
  catatan   String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  transaksi Transaksi[]

  @@index([telepon])
  @@index([nama])
  @@map("penyewa")
}

model Kasir {
  id          String             @id @default(uuid())
  nama        String
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  createdBy   String?
  transaksi   Transaksi[]
  pengeluaran PengeluaranKasir[]

  @@index([nama])
  @@index([isActive])
  @@index([createdAt])
  @@map("kasir")
}

model Transaksi {
  id              String               @id @default(uuid())
  kode            String               @unique
  penyewaId       String
  kasirId         String?
  status          String               @default("active")
  totalHarga      Decimal              @default(0) @db.Decimal(10, 2)
  jumlahBayar     Decimal              @default(0) @db.Decimal(10, 2)
  sisaBayar       Decimal              @default(0) @db.Decimal(10, 2)
  tglMulai        DateTime
  tglSelesai      DateTime?
  tglKembali      DateTime?
  metodeBayar     String               @default("tunai")
  catatan         String?
  createdBy       String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  flatLatePenalty Decimal              @default(0) @db.Decimal(10, 2)
  isLateReturn    Boolean              @default(false)
  // New fields for discount system
  discountType    String?              // 'percent' | 'nominal' | null
  discountValue   Decimal?             @db.Decimal(10, 2)
  aktivitas       AktivitasTransaksi[]
  pembayaran      Pembayaran[]
  penyewa         Penyewa              @relation(fields: [penyewaId], references: [id])
  kasir           Kasir?               @relation(fields: [kasirId], references: [id])
  items           TransaksiItem[]

  @@index([kode])
  @@index([status])
  @@index([penyewaId])
  @@index([kasirId])
  @@index([createdAt])
  @@index([status, id], map: "idx_transaksi_status_id_validation")
  @@index([id, tglSelesai, status], map: "idx_transaksi_penalty_dates")
  @@index([isLateReturn], map: "idx_transaksi_late_penalty")
  @@index([discountType])  // New index for discount queries
  // TASK 2: Performance optimization indexes for date-aware queries
  @@index([tglMulai, tglSelesai, status], map: "idx_transaksi_date_range_status")
  @@index([penyewaId, status, createdAt], map: "idx_transaksi_customer_history")
  @@map("transaksi")
}

model TransaksiItem {
  id                     String                @id @default(uuid())
  transaksiId            String
  produkId               String
  jumlah                 Int                   @default(1)
  hargaSewa              Decimal               @db.Decimal(10, 2)
  durasi                 Int
  subtotal               Decimal               @db.Decimal(10, 2)
  kondisiAwal            String?
  statusKembali          String                @default("belum")
  jumlahDiambil          Int                   @default(0)
  totalReturnPenalty     Decimal               @default(0) @db.Decimal(10, 2)
  conditionCount         Int                   @default(1)
  migratedFromSingleMode Boolean               @default(false)
  produk                 Product               @relation(fields: [produkId], references: [id])
  transaksi              Transaksi             @relation(fields: [transaksiId], references: [id], onDelete: Cascade)
  returnConditions       TransaksiItemReturn[]

  @@index([transaksiId])
  @@index([produkId])
  @@index([id, statusKembali, jumlahDiambil], map: "idx_transaksi_item_status_lookup")
  @@index([produkId, transaksiId, statusKembali], map: "idx_transaksi_item_product_join")
  @@index([id, statusKembali, conditionCount], map: "idx_transaksi_item_unified_processing")
  @@index([migratedFromSingleMode, conditionCount], map: "idx_transaksi_item_migration_history")
  // ❌ REMOVED: Hash index on kondisiAwal was ineffective for contains/startsWith queries
  // PostgreSQL Hash indexes don't support pattern matching operations
  // The stockValidationService now uses 'contains' to search JSON, which doesn't use this index
  // ✅ PERFORMANCE FIX: Add new indexes for transaction item performance
  @@index([transaksiId, produkId], map: "idx_transaksi_item_product_join_fast")
  @@index([transaksiId, statusKembali, jumlahDiambil], map: "idx_transaksi_item_pickup")
  @@map("transaksi_item")
}

model TransaksiItemReturn {
  id                 String            @id @default(uuid())
  transaksiItemId    String
  kondisiAkhir       String
  jumlahKembali      Int
  penaltyAmount      Decimal           @default(0) @db.Decimal(10, 2)
  modalAwalUsed      Decimal?          @db.Decimal(10, 2)
  penaltyCalculation Json?
  createdAt          DateTime          @default(now())
  createdBy          String
  conditionCategory  ConditionCategory @default(BAIK)
  manualPrice        Decimal?          @db.Decimal(10, 2)
  useManualPricing   Boolean           @default(false)
  resolutionStatus   String?           // 'resolved_replaced' | 'resolved_lost' (NEW: Task 1.2)
  resolutionDate     DateTime?         // When resolution was completed (NEW: Task 1.2)
  resolutionNotes    String?           // Optional notes about resolution (NEW: Task 1.2)
  transaksiItem      TransaksiItem     @relation(fields: [transaksiItemId], references: [id], onDelete: Cascade)

  @@index([transaksiItemId, createdAt], map: "idx_transaksi_item_return_timeline")
  @@index([transaksiItemId, penaltyAmount], map: "idx_transaksi_item_return_penalty")
  @@index([conditionCategory], map: "idx_transaksi_item_return_condition")
  @@index([useManualPricing, manualPrice], map: "idx_transaksi_item_return_manual_pricing")
  @@index([resolutionStatus], map: "idx_transaksi_item_return_resolution")
  @@map("transaksi_item_return")
}

model Pembayaran {
  id               String    @id @default(uuid())
  transaksiId      String
  jumlah           Decimal   @db.Decimal(10, 2)
  metode           String
  referensi        String?
  catatan          String?
  createdBy        String
  createdAt        DateTime  @default(now())
  penaltyBreakdown Json?     // NEW: Detailed penalty breakdown for metode='penalty'
  transaksi        Transaksi @relation(fields: [transaksiId], references: [id], onDelete: Cascade)

  @@index([transaksiId])
  @@index([createdAt])
  @@index([metode, createdAt])  // NEW: For penalty payment queries
  @@map("pembayaran")
}

model AktivitasTransaksi {
  id          String    @id @default(uuid())
  transaksiId String
  tipe        String
  deskripsi   String
  data        Json?
  createdBy   String
  createdAt   DateTime  @default(now())
  transaksi   Transaksi @relation(fields: [transaksiId], references: [id], onDelete: Cascade)

  @@index([transaksiId])
  @@index([tipe])
  @@index([createdAt])
  // TASK 2: Performance optimization index for activity log filtering
  @@index([tipe, createdAt], map: "idx_aktivitas_type_created")
  @@map("aktivitas_transaksi")
}

model FileUpload {
  id         String   @id @default(uuid())
  filename   String
  url        String
  mimetype   String
  size       Int
  entityType String
  entityId   String
  createdBy  String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("file_upload")
}

enum ProductStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
}

enum ConditionCategory {
  BAIK
  KOTOR
  RUSAK_RINGAN
  RUSAK_BERAT
  HILANG
}

enum AgeCategory {
  ADULT
  CHILD
  UNIVERSAL
}

enum SizeEnum {
  XS
  S
  M
  L
  XL
  XXL
  UNIVERSAL
}

model PengeluaranKasir {
  id        String   @id @default(uuid())
  kasirId   String
  harga     Decimal  @db.Decimal(12, 2)
  kategori  String   // 'Operasional' | 'Maintenance' | 'Transport' | 'Lainnya'
  deskripsi String?
  isActive  Boolean  @default(true)  // For soft delete
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  
  kasir     Kasir    @relation(fields: [kasirId], references: [id])
  
  @@index([kasirId, createdAt])
  @@index([isActive])
  @@index([createdAt])
  @@map("pengeluaran_kasir")
}

model CostItem {
  id           String        @id @default(uuid())
  name         String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  createdBy    String
  productCosts ProductCost[]

  @@index([name])
  @@index([createdBy])
  @@map("cost_items")
}

model ProductCost {
  id         String   @id @default(uuid())
  productId  String
  costItemId String
  amount     Decimal  @db.Decimal(12, 2)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  costItem CostItem @relation(fields: [costItemId], references: [id], onDelete: Restrict)

  @@unique([productId, costItemId])
  @@index([productId])
  @@index([costItemId])
  @@map("product_costs")
}
