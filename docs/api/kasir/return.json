        {
          "name": "RPK-51: Size Validation Error - Invalid Size ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Size validation error response', function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson).to.have.property('success', false);",
                  "    // Note: This test now expects VALIDATION_ERROR instead of SIZE_VALIDATION_ERROR",
                  "    // due to our enhanced error handling in route.ts",
                  "    pm.expect(responseJson.error).to.have.property('code', 'VALIDATION_ERROR');",
                  "    pm.expect(responseJson.error.message).to.include('tidak tersedia untuk produk');",
                  "});",
                  "",
                  "pm.test('Enhanced size error message with detailed validation', function () {",
                  "    const error = pm.response.json().error;",
                  "    // Check for validationErrors array (new format)",
                  "    if (error.validationErrors) {",
                  "        pm.expect(error.validationErrors).to.be.an('array');",
                  "        const sizeError = error.validationErrors.find(e => e.code === 'SIZE_NOT_AVAILABLE');",
                  "        pm.expect(sizeError, 'Should have SIZE_NOT_AVAILABLE error').to.exist;",
                  "        pm.expect(sizeError.message).to.include('tidak tersedia untuk produk');",
                  "    } else {",
                  "        // Fallback for suggestions if still using old format",
                  "        pm.expect(error).to.have.property('suggestions');",
                  "        pm.expect(error.suggestions).to.be.an('array');",
                  "        const hasSizeSuggestion = error.suggestions.some(s => ",
                  "            s.includes('ukuran') || s.includes('tersedia') || s.includes('inventaris')",
                  "        );",
                  "        pm.expect(hasSizeSuggestion, 'Should have size-specific suggestions').to.be.true;",
                  "    }",
                  "});",
                  "",
                  "pm.test('Size error details properly structured', function () {",
                  "    const error = pm.response.json().error;",
                  "    pm.expect(error).to.have.property('message');",
                  "    pm.expect(error.message).to.include('tidak tersedia untuk produk');",
                  "    pm.expect(error.code).to.equal('VALIDATION_ERROR'); // Updated to new format",
                  "    ",
                  "    // Additional validation for new error structure",
                  "    if (error.validationErrors) {",
                  "        pm.expect(error.validationErrors.length).to.be.above(0);",
                  "        const sizeError = error.validationErrors.find(e => e.code === 'SIZE_NOT_AVAILABLE');",
                  "        pm.expect(sizeError, 'Should contain SIZE_NOT_AVAILABLE validation error').to.exist;",
                  "    }",
                  "});"
                ]
              }
            }
          ],
