              }
            ],
            "url": {
              "raw": "{{base_url}}/api/materials/{{material_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "materials", "{{material_id}}"]
            },
            "description": "Soft delete material berdasarkan ID dengan conflict detection"
          },
          "response": [
