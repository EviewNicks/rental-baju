        {
          "name": "Test Cache Hit (Repeat Request)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/kasir/transaksi/product-history?productSizeId={{productSizeId}}&limit=5",
              "host": ["{{base_url}}"],
              "path": ["api", "kasir", "transaksi", "product-history"],
              "query": [
                {
                  "key": "productSizeId",
