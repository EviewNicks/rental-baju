  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Set default headers",
          "pm.request.headers.add({",
          "  key: 'User-Agent',",
          "  value: 'PostmanRuntime/7.32.3'",
          "});",
          "",
          "// Auto-generate productSizeId if not set (untuk testing)",
          "if (!pm.collectionVariables.get('productSizeId')) {",
          "  pm.collectionVariables.set('productSizeId', 'test-size-uuid-' + Date.now());",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Enhanced test script for Product History API (Availability Product View)",
          "pm.test('Status code is success (200) or expected error', function () {",
          "  pm.expect(pm.response.code).to.be.oneOf([200, 400, 401, 500]);",
          "});",
          "",
          "pm.test('Response time is acceptable (<2s SLA)', function () {",
          "  pm.expect(pm.response.responseTime).to.be.below(2000);",
          "});",
          "",
          "// Test successful responses",
          "if (pm.response.code === 200) {",
          "  pm.test('Success response has correct structure', function () {",
          "    const response = pm.response.json();",
          "    ",
          "    // Basic structure validation",
          "    pm.expect(response).to.have.property('success');",
          "    pm.expect(response.success).to.eql(true);",
          "    pm.expect(response).to.have.property('data');",
          "    pm.expect(response.data).to.be.an('array');",
          "    pm.expect(response).to.have.property('cached');",
          "    pm.expect(response.cached).to.be.a('boolean');",
          "    pm.expect(response).to.have.property('metadata');",
          "    ",
          "    // Metadata validation",
          "    const metadata = response.metadata;",
          "    pm.expect(metadata).to.have.property('productSizeId');",
          "    pm.expect(metadata).to.have.property('statuses');",
          "    pm.expect(metadata).to.have.property('limit');",
          "    pm.expect(metadata).to.have.property('sortBy');",
          "    pm.expect(metadata).to.have.property('totalResults');",
          "    pm.expect(metadata).to.have.property('cacheExpiresAt');",
          "    pm.expect(metadata).to.have.property('serviceUsed');",
          "    ",
          "    // Service validation",
          "    pm.expect(metadata.serviceUsed).to.eql('ItemHistoryService');",
          "  });",
          "  ",
          "  pm.test('Transaction history data structure is correct', function () {",
          "    const response = pm.response.json();",
          "    ",
          "    if (response.data.length > 0) {",
          "      const historyItem = response.data[0];",
          "      ",
          "      // Required fields validation",
          "      pm.expect(historyItem).to.have.property('id');",
          "      pm.expect(historyItem).to.have.property('transactionCode');",
          "      pm.expect(historyItem).to.have.property('customerName');",
          "      pm.expect(historyItem).to.have.property('quantity');",
          "      pm.expect(historyItem).to.have.property('tglMulai');",
          "      pm.expect(historyItem).to.have.property('tglSelesai');",
          "      pm.expect(historyItem).to.have.property('status');",
          "      pm.expect(historyItem).to.have.property('dateRange');",
          "      pm.expect(historyItem).to.have.property('displayText');",
          "      pm.expect(historyItem).to.have.property('daysFromNow');",
          "      ",
          "      // Data type validation",
          "      pm.expect(historyItem.quantity).to.be.a('number');",
          "      pm.expect(historyItem.quantity).to.be.above(0);",
          "      pm.expect(historyItem.daysFromNow).to.be.a('number');",
          "      ",
          "      // Status validation (only 'active' and 'diambil' allowed)",
          "      pm.expect(historyItem.status).to.be.oneOf(['active', 'diambil']);",
          "      ",
          "      // Display text format validation",
          "      const expectedFormat = new RegExp(`${historyItem.transactionCode} \\\\(${historyItem.quantity} item\\\\) untuk .+`);",
          "      pm.expect(historyItem.displayText).to.match(expectedFormat);",
          "    }",
          "  });",
          "  ",
          "  pm.test('Status filtering works correctly', function () {",
          "    const response = pm.response.json();",
          "    const metadata = response.metadata;",
          "    ",
          "    // Verify only allowed statuses",
          "    pm.expect(metadata.statuses).to.be.an('array');",
          "    metadata.statuses.forEach(status => {",
          "      pm.expect(status).to.be.oneOf(['active', 'diambil']);",
          "    });",
          "    ",
          "    // Verify data matches status filter",
          "    response.data.forEach(item => {",
          "      pm.expect(metadata.statuses).to.include(item.status);",
          "    });",
          "  });",
          "  ",
          "  pm.test('Sorting works correctly', function () {",
          "    const response = pm.response.json();",
          "    const metadata = response.metadata;",
          "    ",
          "    if (response.data.length > 1) {",
          "      const sortBy = metadata.sortBy;",
          "      ",
          "      if (sortBy === 'date_proximity') {",
          "        // Check if sorted by days from now (ascending)",
          "        for (let i = 1; i < response.data.length; i++) {",
          "          const prev = Math.abs(response.data[i-1].daysFromNow);",
          "          const curr = Math.abs(response.data[i].daysFromNow);",
          "          pm.expect(prev).to.be.at.most(curr);",
          "        }",
          "      } else if (sortBy === 'date_asc') {",
          "        // Check if sorted by start date ascending",
          "        for (let i = 1; i < response.data.length; i++) {",
          "          const prevDate = new Date(response.data[i-1].tglMulai);",
          "          const currDate = new Date(response.data[i].tglMulai);",
          "          pm.expect(prevDate.getTime()).to.be.at.most(currDate.getTime());",
          "        }",
          "      } else if (sortBy === 'date_desc') {",
          "        // Check if sorted by start date descending",
          "        for (let i = 1; i < response.data.length; i++) {",
          "          const prevDate = new Date(response.data[i-1].tglMulai);",
          "          const currDate = new Date(response.data[i].tglMulai);",
          "          pm.expect(prevDate.getTime()).to.be.at.least(currDate.getTime());",
          "        }",
          "      }",
          "    }",
          "  });",
          "  ",
          "  pm.test('Cache behavior is correct', function () {",
          "    const response = pm.response.json();",
          "    ",
          "    if (response.cached) {",
          "      // Cache hit - should have cachedAt",
          "      pm.expect(response).to.have.property('cachedAt');",
          "      pm.expect(response.cachedAt).to.be.a('string');",
          "      ",
          "      // Response time should be faster for cached responses",
          "      pm.expect(pm.response.responseTime).to.be.below(500);",
          "    } else {",
          "      // Cache miss - should not have cachedAt",
          "      pm.expect(response).to.not.have.property('cachedAt');",
          "    }",
          "    ",
          "    // Cache expiration should always be set",
          "    pm.expect(response.metadata.cacheExpiresAt).to.be.a('string');",
          "    const expiresAt = new Date(response.metadata.cacheExpiresAt);",
          "    const now = new Date();",
          "    pm.expect(expiresAt.getTime()).to.be.above(now.getTime());",
          "  });",
          "}",
          "",
          "// Test error responses",
          "if (pm.response.code === 400) {",
          "  pm.test('Bad request has proper error structure', function () {",
          "    const response = pm.response.json();",
          "    pm.expect(response).to.have.property('error');",
          "    pm.expect(response.error).to.be.a('string');",
          "    ",
          "    // Check for specific error messages",
          "    if (response.error.includes('productSizeId')) {",
          "      pm.expect(response.error).to.include('required');",
          "    }",
          "  });",
          "}",
          "",
          "if (pm.response.code === 401) {",
          "  pm.test('Unauthorized response is correct', function () {",
          "    const response = pm.response.json();",
          "    pm.expect(response).to.have.property('error');",
          "    pm.expect(response.error).to.eql('Unauthorized');",
          "  });",
          "}",
          "",
          "if (pm.response.code === 500) {",
          "  pm.test('Server error has proper structure', function () {",
          "    const response = pm.response.json();",
          "    pm.expect(response).to.have.property('error');",
          "    pm.expect(response).to.have.property('details');",
          "    pm.expect(response.error).to.include('Failed to fetch product history');",
          "  });",
          "}",
          "",
          "// Performance monitoring",
          "pm.test('API performance meets requirements', function () {",
          "  const responseTime = pm.response.responseTime;",
          "  const response = pm.response.json();",
          "  ",
          "  if (pm.response.code === 200 && response.cached) {",
          "    // Cache hit should be very fast",
          "    pm.expect(responseTime).to.be.below(500);",
          "  } else {",
          "    // Fresh requests should meet SLA",
          "    pm.expect(responseTime).to.be.below(2000);",
          "  }",
          "});",
          "",
          "// Store productSizeId if returned in response (for chaining)",
          "if (pm.response.code === 200) {",
          "  const response = pm.response.json();",
          "  if (response.metadata && response.metadata.productSizeId) {",
          "    pm.collectionVariables.set('productSizeId', response.metadata.productSizeId);",
          "  }",
          "}",
          "",
          "// Log performance metrics for monitoring",
          "console.log(`Product History API Performance:`,",
          "  `Response Time: ${pm.response.responseTime}ms,`,",
          "  `Status: ${pm.response.code},`,",
          "  `Cached: ${pm.response.code === 200 ? pm.response.json().cached : 'N/A'}`",
          ");"
        ]
      }
    }
  ]
}